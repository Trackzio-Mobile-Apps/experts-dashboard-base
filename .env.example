# White-label expert dashboard
# Copy to .env.local and set values BEFORE `npm run build`.
# These are baked into `dist/` — Netlify site env does nothing if you only upload dist.

API_BASE_URL=https://coinzy-experts-api.trackzio.com

# Optional. Socket.IO origin; defaults to API_BASE_URL.
# SOCKET_URL=https://coinzy-experts-api.trackzio.com

# Brand (not VITE_ / NEXT_PUBLIC_)
APP_NAME=Coinzy
APP_TITLE=Coinzy Expert Portal
APP_SLUG=coinzy
APP_LOGO_URL=/coinzy-logo.png
APP_FAVICON_URL=/favicon.png
APP_REPORT_NAME=Coinzy AI

# Scripts only (seed / JWT helpers)
# ADMIN_API_KEY=
# USER_JWT_SHARED_SECRET=
